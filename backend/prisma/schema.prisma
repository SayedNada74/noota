generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum StorePlan {
  TRIAL
  PRO
  ENTERPRISE
}

model Store {
  id               String        @id @default(uuid())
  name             String
  phone            String        @unique
  address          String?
  category         String        @default("supermarket")
  currency         String        @default("ج.م")
  whatsappTemplate String?       @default("السلام عليكم أستاذ {customer_name}، نود تذكيرك بأن لديك حساب متبقي بقيمة {balance} {currency} لدى ({store_name}).")
  instapayHandle   String?
  vodafoneCash     String?
  plan             StorePlan     @default(TRIAL)
  planExpiresAt    DateTime?
  isActive         Boolean       @default(true)
  
  users            User[]
  customers        Customer[]
  transactions     Transaction[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("stores")
}

model User {
  id           String        @id @default(uuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  name         String
  phone        String        @unique
  passwordHash String
  role         UserRole      @default(OWNER)
  
  transactions Transaction[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([storeId])
  @@map("users")
}

model Customer {
  id             String        @id @default(uuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  name           String
  phone          String?
  address        String?
  notes          String?
  
  // الرصيد: موجب = عليه فلوس للتاجر (مدين)، سالب = له رصيد لدى التاجر (دائن)
  currentBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  creditLimit    Decimal?      @db.Decimal(12, 2) // الحد الائتماني الأقصى المسموح به للدين
  
  transactions   Transaction[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([storeId, phone])
  @@index([storeId, name])
  @@map("customers")
}

enum TransactionType {
  DEBT    // أخذ بضاعة على الحساب (دين يضاف للرصيد)
  PAYMENT // سداد دفعة نقدية (يخصم من الرصيد)
}

model Transaction {
  id           String          @id @default(uuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  note         String?
  
  createdAt    DateTime        @default(now())

  @@index([storeId, customerId])
  @@index([storeId, createdAt])
  @@map("transactions")
}
